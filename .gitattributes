class CampusEventManager {
  constructor() {
    this.events = [];
    this.myRegistrations = [];
    this.currentFilterCategory = "All";
    this.currentSearchQuery = "";
    this.currentStatusFilter = "All";
    this.activeRosterEvent = null;

    this.init();
  }

  init() {
    this.loadState();
    this.renderEvents();
    this.updateMyTicketsBadge();
    this.updateAdminDashboard();
  }

  // LocalStorage state management
  loadState() {
    const storedEvents = localStorage.getItem("campuspulse_events");
    const storedRegistrations = localStorage.getItem("campuspulse_my_tickets");

    if (storedEvents) {
      try {
        this.events = JSON.parse(storedEvents);
      } catch (e) {
        this.events = [...DEFAULT_EVENTS];
      }
    } else {
      this.events = [...DEFAULT_EVENTS];
      this.saveState();
    }

    if (storedRegistrations) {
      try {
        this.myRegistrations = JSON.parse(storedRegistrations);
      } catch (e) {
        this.myRegistrations = [];
      }
    } else {
      // Seed initial student ticket for demo
      this.myRegistrations = [
        {
          ticketId: "TKT-829104",
          eventId: "EVT-101",
          eventTitle: "HackCampus 2026: 24h AI & Cloud Sprint",
          category: "Technical",
          date: "2026-11-05",
          time: "09:30",
          venue: "Innovation Hub, Tech Block 4",
          organizer: "Computer Science Society & ACM Club",
          name: "Aarav Sharma",
          studentId: "CS2024-019",
          department: "Computer Science",
          year: "3rd Year",
          registeredAt: "2026-10-20 14:32"
        }
      ];
      this.saveState();
    }
  }

  saveState() {
    localStorage.setItem("campuspulse_events", JSON.stringify(this.events));
    localStorage.setItem("campuspulse_my_tickets", JSON.stringify(this.myRegistrations));
  }

  resetData() {
    if (confirm("Reset all events and tickets to default demo state?")) {
      localStorage.removeItem("campuspulse_events");
      localStorage.removeItem("campuspulse_my_tickets");
      this.events = [...DEFAULT_EVENTS];
      this.myRegistrations = [
        {
          ticketId: "TKT-829104",
          eventId: "EVT-101",
          eventTitle: "HackCampus 2026: 24h AI & Cloud Sprint",
          category: "Technical",
          date: "2026-11-05",
          time: "09:30",
          venue: "Innovation Hub, Tech Block 4",
          organizer: "Computer Science Society & ACM Club",
          name: "Aarav Sharma",
          studentId: "CS2024-019",
          department: "Computer Science",
          year: "3rd Year",
          registeredAt: "2026-10-20 14:32"
        }
      ];
      this.saveState();
      this.renderEvents();
      this.renderMyTickets();
      this.updateMyTicketsBadge();
      this.updateAdminDashboard();
      this.showToast("Demo data successfully restored!", "success");
    }
  }

  // Navigation tab switcher
  switchTab(tabId) {
    document.querySelectorAll(".tab-pane").forEach(pane => pane.classList.remove("active"));
    document.querySelectorAll(".nav-tab").forEach(tab => tab.classList.remove("active"));

    const targetPane = document.getElementById(`tab-${tabId}`);
    const targetTab = document.querySelector(`[data-tab="${tabId}"]`);

    if (targetPane) targetPane.classList.add("active");
    if (targetTab) targetTab.classList.add("active");

    if (tabId === "my-tickets") {
      this.renderMyTickets();
    } else if (tabId === "admin") {
      this.updateAdminDashboard();
    } else if (tabId === "explore") {
      this.renderEvents();
    }
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  // Search & Filtering
  filterEvents() {
    this.currentSearchQuery = document.getElementById("searchInput").value.trim().toLowerCase();
    this.currentFilterCategory = document.getElementById("categoryFilter").value;
    this.currentStatusFilter = document.getElementById("statusFilter").value;
    this.renderEvents();
  }

  setQuickFilter(category, buttonEl) {
    document.querySelectorAll(".category-chips .chip").forEach(btn => btn.classList.remove("active"));
    buttonEl.classList.add("active");

    const categorySelect = document.getElementById("categoryFilter");
    if (categorySelect) categorySelect.value = category;

    this.currentFilterCategory = category;
    this.renderEvents();
  }

  clearFilters() {
    document.getElementById("searchInput").value = "";
    document.getElementById("categoryFilter").value = "All";
    document.getElementById("statusFilter").value = "All";
    document.querySelectorAll(".category-chips .chip").forEach(btn => {
      btn.classList.toggle("active", btn.textContent.trim() === "All Events");
    });
    this.currentSearchQuery = "";
    this.currentFilterCategory = "All";
    this.currentStatusFilter = "All";
    this.renderEvents();
  }

  getFilteredEvents() {
    return this.events.filter(event => {
      // Category match
      const matchCategory = this.currentFilterCategory === "All" || event.category === this.currentFilterCategory;

      // Search query match (title, description, organizer, venue, tags)
      const q = this.currentSearchQuery;
      const matchSearch = !q || (
        event.title.toLowerCase().includes(q) ||
        event.organizer.toLowerCase().includes(q) ||
        event.venue.toLowerCase().includes(q) ||
        event.description.toLowerCase().includes(q) ||
        (event.tags && event.tags.some(tag => tag.toLowerCase().includes(q)))
      );

      // Status filter match
      const booked = (event.registeredStudents || []).length;
      const seatsLeft = event.capacity - booked;
      let matchStatus = true;
      if (this.currentStatusFilter === "Available") {
        matchStatus = seatsLeft > 0;
      } else if (this.currentStatusFilter === "FastFilling") {
        matchStatus = seatsLeft > 0 && (booked / event.capacity >= 0.7);
      }

      return matchCategory && matchSearch && matchStatus;
    });
  }

  // Format Helpers
  formatDate(dateStr) {
    try {
      const options = { weekday: "short", month: "short", day: "numeric", year: "numeric" };
      return new Date(dateStr).toLocaleDateString("en-US", options);
    } catch (e) {
      return dateStr;
    }
  }

  formatTime(timeStr) {
    if (!timeStr) return "";
    const [h, m] = timeStr.split(":");
    const hour = parseInt(h, 10);
    const ampm = hour >= 12 ? "PM" : "AM";
    const formattedHour = hour % 12 || 12;
    return `${formattedHour}:${m} ${ampm}`;
  }

  getCategoryClass(category) {
    switch (category.toLowerCase()) {
      case "technical": return "tech";
      case "cultural": return "cultural";
      case "sports": return "sports";
      case "academic": return "academic";
      case "workshop": return "workshop";
      default: return "";
    }
  }

  // Render Event Discovery Grid
  renderEvents() {
    const grid = document.getElementById("eventsGrid");
    const emptyState = document.getElementById("noEventsState");
    const countLabel = document.getElementById("eventsCountLabel");

    const filtered = this.getFilteredEvents();

    if (countLabel) {
      countLabel.textContent = `Showing ${filtered.length} of ${this.events.length} campus events`;
    }

    if (filtered.length === 0) {
      grid.innerHTML = "";
      emptyState.classList.remove("hidden");
      return;
    }

    emptyState.classList.add("hidden");

    grid.innerHTML = filtered.map(event => {
      const regCount = (event.registeredStudents || []).length;
      const capacity = event.capacity;
      const seatsLeft = Math.max(0, capacity - regCount);
      const isFull = seatsLeft === 0;
      const percentBooked = Math.min(100, Math.round((regCount / capacity) * 100));

      let progressClass = "";
      if (percentBooked >= 90) progressClass = "full";
      else if (percentBooked >= 70) progressClass = "almost-full";

      // Check if user already registered
      const isRegistered = this.myRegistrations.some(t => t.eventId === event.id);

      return `
        <article class="event-card">
          <div class="event-card-header ${this.getCategoryClass(event.category)}">
            <div class="card-top-badges">
              <span class="category-badge">${event.category}</span>
              <span class="seats-badge ${isFull ? 'full' : ''}">
                ${isFull ? 'Sold Out' : `${seatsLeft} seats left`}
              </span>
            </div>
            <div class="event-card-organizer">🏛️ ${event.organizer}</div>
          </div>

          <div class="event-card-body">
            <h3 class="event-title">${event.title}</h3>
            <p class="event-description">${event.description}</p>

            <div class="capacity-wrapper">
              <div class="capacity-text">
                <span>Booked: ${regCount} / ${capacity}</span>
                <span>${percentBooked}%</span>
              </div>
              <div class="progress-bar-bg">
                <div class="progress-bar-fill ${progressClass}" style="width: ${percentBooked}%"></div>
              </div>
            </div>

            <div class="event-meta-info">
              <div class="meta-row">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                <span>${this.formatDate(event.date)} at ${this.formatTime(event.time)}</span>
              </div>
              <div class="meta-row">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                <span>${event.venue}</span>
              </div>
            </div>

            <div class="event-card-footer">
              ${isRegistered ? `
                <button class="btn btn-secondary" onclick="app.viewMyTicketByEvent('${event.id}')">
                  🎟️ View My Ticket
                </button>
              ` : `
                <button class="btn btn-primary" ${isFull ? 'disabled style="opacity:0.6; cursor:not-allowed;"' : ''} onclick="app.openRegistrationModal('${event.id}')">
                  ${isFull ? 'Waitlist / Full' : 'Register Now'}
                </button>
              `}
            </div>
          </div>
        </article>
      `;
    }).join("");
  }

  // Open Event Registration Modal
  openRegistrationModal(eventId) {
    const event = this.events.find(e => e.id === eventId);
    if (!event) return;

    const regCount = (event.registeredStudents || []).length;
    const seatsLeft = event.capacity - regCount;

    if (seatsLeft <= 0) {
      this.showToast("Sorry, this event has reached maximum capacity!", "error");
      return;
    }

    document.getElementById("regEventId").value = event.id;
    document.getElementById("regEventCategory").textContent = event.category;
    document.getElementById("regEventTitle").textContent = event.title;
    document.getElementById("regEventDateTime").textContent = `${this.formatDate(event.date)} @ ${this.formatTime(event.time)}`;
    document.getElementById("regEventVenue").textContent = event.venue;
    document.getElementById("regEventSeatsLeft").textContent = `${seatsLeft} of ${event.capacity} seats remaining`;

    document.getElementById("registrationModal").classList.remove("hidden");
  }

  // Handle Student Registration Submit
  handleRegistrationSubmit(e) {
    e.preventDefault();

    const eventId = document.getElementById("regEventId").value;
    const studentName = document.getElementById("studentName").value.trim();
    const studentId = document.getElementById("studentId").value.trim().toUpperCase();
    const studentEmail = document.getElementById("studentEmail").value.trim().toLowerCase();
    const studentDept = document.getElementById("studentDept").value;
    const studentYear = document.getElementById("studentYear").value;
    const studentPhone = document.getElementById("studentPhone").value.trim();

    const event = this.events.find(ev => ev.id === eventId);
    if (!event) {
      this.showToast("Event not found!", "error");
      return;
    }

    if (!event.registeredStudents) {
      event.registeredStudents = [];
    }

    // Check duplicate student registration
    const existing = event.registeredStudents.find(s => s.studentId === studentId);
    if (existing) {
      this.showToast(`Student ID ${studentId} is already registered for this event!`, "error");
      return;
    }

    // Check capacity
    if (event.registeredStudents.length >= event.capacity) {
      this.showToast("Sorry, this event is already full!", "error");
      return;
    }

    const uniqueTicketId = "TKT-" + Math.floor(100000 + Math.random() * 900000);
    const now = new Date();
    const formattedRegTime = now.toISOString().replace("T", " ").substring(0, 16);

    const attendeeRecord = {
      ticketId: uniqueTicketId,
      name: studentName,
      studentId: studentId,
      email: studentEmail,
      department: studentDept,
      year: studentYear,
      phone: studentPhone || "N/A",
      registeredAt: formattedRegTime,
      attended: false
    };

    // Save to event roster
    event.registeredStudents.push(attendeeRecord);

    // Save to user's registered tickets
    const ticketRecord = {
      ...attendeeRecord,
      eventId: event.id,
      eventTitle: event.title,
      category: event.category,
      date: event.date,
      time: event.time,
      venue: event.venue,
      organizer: event.organizer
    };
    this.myRegistrations.unshift(ticketRecord);

    this.saveState();
    this.closeModal("registrationModal");
    e.target.reset();

    this.renderEvents();
    this.updateMyTicketsBadge();
    this.updateAdminDashboard();

    this.showToast("Registration Successful! Your ticket has been generated.", "success");
    this.showTicketModal(ticketRecord);
  }

  // View Ticket by Event ID
  viewMyTicketByEvent(eventId) {
    const ticket = this.myRegistrations.find(t => t.eventId === eventId);
    if (ticket) {
      this.showTicketModal(ticket);
    } else {
      this.showToast("No ticket found for this event.", "error");
    }
  }

