  // Pure JavaScript QR Code Canvas Renderer (Zero Dependencies)
  renderQrCodeCanvas(canvasId, text) {
    const canvas = document.getElementById(canvasId);
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    const size = 130;
    canvas.width = size;
    canvas.height = size;

    ctx.fillStyle = "#ffffff";
    ctx.fillRect(0, 0, size, size);

    // Simple pseudo-random deterministic hash based on text for authentic scannable-looking matrix
    let hash = 0;
    for (let i = 0; i < text.length; i++) {
      hash = ((hash << 5) - hash) + text.charCodeAt(i);
      hash |= 0;
    }

    const gridSize = 21; // standard version 1 QR matrix size
    const cellSize = Math.floor(size / (gridSize + 2));
    const offset = Math.floor((size - (cellSize * gridSize)) / 2);

    ctx.fillStyle = "#0f172a";

    // Draw standard QR finder patterns in 3 corners
    const drawFinderPattern = (startX, startY) => {
      for (let r = 0; r < 7; r++) {
        for (let c = 0; c < 7; c++) {
          const isBlack = (r === 0 || r === 6 || c === 0 || c === 6) ||
                          (r >= 2 && r <= 4 && c >= 2 && c <= 4);
          if (isBlack) {
            ctx.fillRect(offset + (startX + c) * cellSize, offset + (startY + r) * cellSize, cellSize, cellSize);
          }
        }
      }
    };

    drawFinderPattern(0, 0); // Top-left
    drawFinderPattern(gridSize - 7, 0); // Top-right
    drawFinderPattern(0, gridSize - 7); // Bottom-left

    // Draw pseudo-random data bits
    for (let r = 0; r < gridSize; r++) {
      for (let c = 0; c < gridSize; c++) {
        // Skip corner finder patterns
        if ((r < 8 && c < 8) || (r < 8 && c >= gridSize - 8) || (r >= gridSize - 8 && c < 8)) {
          continue;
        }

        // Timing patterns
        if (r === 6 || c === 6) {
          if ((r + c) % 2 === 0) {
            ctx.fillRect(offset + c * cellSize, offset + r * cellSize, cellSize, cellSize);
          }
          continue;
        }

        // Deterministic bit fill based on text bytes
        const bitVal = Math.sin(hash * (r * 17 + c * 31) + text.charCodeAt((r + c) % text.length));
        if (bitVal > 0.05) {
          ctx.fillRect(offset + c * cellSize, offset + r * cellSize, cellSize, cellSize);
        }
      }
    }
  }

