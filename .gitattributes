  // Cancel RSVP / Free seat
  cancelRegistration(ticketId, eventId) {
    if (!confirm("Are you sure you want to cancel your ticket registration? This will free your seat for other students.")) {
      return;
    }

    // Remove from myRegistrations
    this.myRegistrations = this.myRegistrations.filter(t => t.ticketId !== ticketId);

    // Remove from event's registeredStudents
    const event = this.events.find(e => e.id === eventId);
    if (event && event.registeredStudents) {
      event.registeredStudents = event.registeredStudents.filter(s => s.ticketId !== ticketId);
    }

    this.saveState();
    this.renderMyTickets();
    this.renderEvents();
    this.updateMyTicketsBadge();
    this.updateAdminDashboard();
    this.showToast("Registration cancelled successfully. Seat restored.", "info");
  }

  updateMyTicketsBadge() {
    const badge = document.getElementById("myTicketsBadge");
    if (badge) {
      badge.textContent = this.myRegistrations.length;
    }
  }

  // ORGANIZER / ADMIN DASHBOARD LOGIC
  updateAdminDashboard() {
    const totalEvents = this.events.length;
    let totalRegs = 0;
    let totalCap = 0;

    this.events.forEach(e => {
      totalCap += e.capacity || 0;
      totalRegs += (e.registeredStudents || []).length;
    });

    const avgOccupancy = totalCap > 0 ? Math.round((totalRegs / totalCap) * 100) : 0;

    document.getElementById("metricTotalEvents").textContent = totalEvents;
    document.getElementById("metricTotalRegs").textContent = totalRegs;
    document.getElementById("metricTotalCapacity").textContent = totalCap;
    document.getElementById("metricAvgOccupancy").textContent = `${avgOccupancy}%`;

    const adminTableCount = document.getElementById("adminTableCount");
    if (adminTableCount) adminTableCount.textContent = `${totalEvents} Events Active`;

    this.renderAdminTable();
  }

  renderAdminTable() {
    const tbody = document.getElementById("adminEventsTableBody");
    if (!tbody) return;

    if (this.events.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding: 2rem;">No events available. Click "+ Publish New Event" to add one.</td></tr>`;
      return;
    }

    tbody.innerHTML = this.events.map(ev => {
      const regCount = (ev.registeredStudents || []).length;
      const isFull = regCount >= ev.capacity;
      const percent = Math.min(100, Math.round((regCount / ev.capacity) * 100));

      return `
        <tr>
          <td>
            <strong>${ev.title}</strong>
            <div style="font-size: 0.775rem; color: var(--text-muted);">🏛️ ${ev.organizer}</div>
          </td>
          <td><span class="category-badge" style="background:#e0e7ff; color:#3730a3;">${ev.category}</span></td>
          <td>
            <div>${this.formatDate(ev.date)}</div>
            <small style="color: var(--text-muted);">${ev.venue}</small>
          </td>
          <td style="min-width: 140px;">
            <div style="display:flex; justify-content:space-between; font-size:0.8rem; margin-bottom:0.25rem;">
              <span>${regCount} / ${ev.capacity}</span>
              <span>${percent}%</span>
            </div>
            <div class="progress-bar-bg">
              <div class="progress-bar-fill ${percent >= 90 ? 'full' : ''}" style="width: ${percent}%;"></div>
            </div>
          </td>
          <td>
            <span class="badge-subtle" style="${isFull ? 'background:#fee2e2; color:#b91c1c;' : 'background:#ecfdf5; color:#047857;'}">
              ${isFull ? 'Sold Out' : 'Active'}
            </span>
          </td>
          <td>
            <div class="table-actions">
              <button class="btn btn-outline-sm" onclick="app.openRosterModal('${ev.id}')" title="View Registered Attendees">
                👥 Roster (${regCount})
              </button>
              <button class="btn btn-outline-sm" onclick="app.openEditEventModal('${ev.id}')" title="Edit Event Details">
                ✏️ Edit
              </button>
              <button class="btn btn-outline-sm btn-danger-outline" onclick="app.deleteEvent('${ev.id}')" title="Delete Event">
                🗑️
              </button>
            </div>
          </td>
        </tr>
      `;
    }).join("");
  }

  // Create / Edit Event Flow
  openCreateModal() {
    document.getElementById("createEventModalTitle").textContent = "Create New Campus Event";
    document.getElementById("editEventId").value = "";
    document.getElementById("createEventForm").reset();
    document.getElementById("btnSaveEvent").textContent = "Publish Event";
    document.getElementById("createEventModal").classList.remove("hidden");
  }

  openEditEventModal(eventId) {
    const event = this.events.find(e => e.id === eventId);
    if (!event) return;

    document.getElementById("createEventModalTitle").textContent = "Edit Campus Event";
    document.getElementById("editEventId").value = event.id;
    document.getElementById("eventTitle").value = event.title;
    document.getElementById("eventCategory").value = event.category;
    document.getElementById("eventOrganizer").value = event.organizer;
    document.getElementById("eventDate").value = event.date;
    document.getElementById("eventTime").value = event.time;
    document.getElementById("eventVenue").value = event.venue;
    document.getElementById("eventCapacity").value = event.capacity;
    document.getElementById("eventTags").value = (event.tags || []).join(", ");
    document.getElementById("eventDesc").value = event.description;

    document.getElementById("btnSaveEvent").textContent = "Save Changes";
    document.getElementById("createEventModal").classList.remove("hidden");
  }

  handleCreateEventSubmit(e) {
    e.preventDefault();

    const editId = document.getElementById("editEventId").value;
    const title = document.getElementById("eventTitle").value.trim();
    const category = document.getElementById("eventCategory").value;
    const organizer = document.getElementById("eventOrganizer").value.trim();
    const date = document.getElementById("eventDate").value;
    const time = document.getElementById("eventTime").value;
    const venue = document.getElementById("eventVenue").value.trim();
    const capacity = parseInt(document.getElementById("eventCapacity").value, 10);
    const rawTags = document.getElementById("eventTags").value;
    const tags = rawTags ? rawTags.split(",").map(t => t.trim()).filter(Boolean) : [];
    const description = document.getElementById("eventDesc").value.trim();

    if (editId) {
      // Edit existing event
      const existing = this.events.find(ev => ev.id === editId);
      if (existing) {
        existing.title = title;
        existing.category = category;
        existing.organizer = organizer;
        existing.date = date;
        existing.time = time;
        existing.venue = venue;
        existing.capacity = capacity;
        existing.tags = tags;
        existing.description = description;

        // Also update any booked tickets in myRegistrations
        this.myRegistrations.forEach(t => {
          if (t.eventId === editId) {
            t.eventTitle = title;
            t.category = category;
            t.date = date;
            t.time = time;
            t.venue = venue;
            t.organizer = organizer;
          }
        });

        this.showToast("Event updated successfully!", "success");
      }
    } else {
      // Create new event
      const newEvent = {
        id: "EVT-" + Math.floor(100 + Math.random() * 900),
        title,
        category,
        organizer,
        date,
        time,
        venue,
        capacity,
        tags,
        description,
        registeredStudents: []
      };
      this.events.unshift(newEvent);
      this.showToast("New event published successfully!", "success");
    }

    this.saveState();
    this.closeModal("createEventModal");
    this.renderEvents();
    this.updateAdminDashboard();
  }

  deleteEvent(eventId) {
    const event = this.events.find(e => e.id === eventId);
    if (!event) return;

    if (!confirm(`Are you sure you want to delete "${event.title}"? All existing attendee registrations will be removed.`)) {
      return;
    }

    this.events = this.events.filter(e => e.id !== eventId);
    this.myRegistrations = this.myRegistrations.filter(t => t.eventId !== eventId);

    this.saveState();
    this.renderEvents();
    this.renderMyTickets();
    this.updateMyTicketsBadge();
    this.updateAdminDashboard();
    this.showToast("Event deleted successfully.", "info");
  }

  // ATTENDEE ROSTER MANAGEMENT & CHECK-IN
  openRosterModal(eventId) {
    const event = this.events.find(e => e.id === eventId);
    if (!event) return;

    this.activeRosterEvent = event;
    document.getElementById("rosterEventTitle").textContent = event.title;
    document.getElementById("rosterSearchInput").value = "";

    this.renderRosterTable(event.registeredStudents || []);
    document.getElementById("rosterModal").classList.remove("hidden");
  }

  filterRoster() {
    if (!this.activeRosterEvent) return;
    const q = document.getElementById("rosterSearchInput").value.trim().toLowerCase();
    const students = this.activeRosterEvent.registeredStudents || [];

    const filtered = students.filter(s => 
      s.name.toLowerCase().includes(q) ||
      s.studentId.toLowerCase().includes(q) ||
      s.email.toLowerCase().includes(q) ||
      s.ticketId.toLowerCase().includes(q)
    );

    this.renderRosterTable(filtered);
  }

  renderRosterTable(students) {
    const tbody = document.getElementById("rosterTableBody");
    const countEl = document.getElementById("rosterCount");
    const checkedInCountEl = document.getElementById("rosterCheckedInCount");

    const total = (this.activeRosterEvent.registeredStudents || []).length;
    const checkedIn = (this.activeRosterEvent.registeredStudents || []).filter(s => s.attended).length;

    countEl.textContent = total;
    checkedInCountEl.textContent = checkedIn;

    if (students.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding: 2rem; color:var(--text-muted);">No attendees found.</td></tr>`;
      return;
    }

    tbody.innerHTML = students.map(s => {
      return `
        <tr>
          <td><code style="font-weight:700; color:var(--primary);">${s.ticketId}</code></td>
          <td><strong>${s.name}</strong></td>
          <td>${s.studentId}</td>
          <td>${s.department} (${s.year || "N/A"})</td>
          <td><small>${s.email}</small></td>
          <td>
            <button class="btn btn-sm ${s.attended ? 'btn-secondary' : 'btn-primary'}" onclick="app.toggleCheckIn('${s.ticketId}')">
              ${s.attended ? '✓ Checked In' : 'Mark Present'}
            </button>
          </td>
        </tr>
      `;
    }).join("");
  }

  toggleCheckIn(ticketId) {
    if (!this.activeRosterEvent) return;

    const student = (this.activeRosterEvent.registeredStudents || []).find(s => s.ticketId === ticketId);
    if (student) {
      student.attended = !student.attended;

      // Update in myRegistrations if it exists there
      const myTicket = this.myRegistrations.find(t => t.ticketId === ticketId);
      if (myTicket) {
        myTicket.attended = student.attended;
      }

      this.saveState();
      this.filterRoster();
      this.showToast(`${student.name} marked as ${student.attended ? 'Present' : 'Absent'}.`, "info");
    }
  }

  // Export Roster as CSV File Download
  exportRosterCSV() {
    if (!this.activeRosterEvent || !(this.activeRosterEvent.registeredStudents || []).length) {
      this.showToast("No attendees to export!", "error");
      return;
    }

    const students = this.activeRosterEvent.registeredStudents;
    let csv = "Ticket ID,Student Name,Roll No,Email,Department,Year,Phone,Registered At,Attendance Status\n";

    students.forEach(s => {
      const row = [
        `"${s.ticketId}"`,
        `"${s.name}"`,
        `"${s.studentId}"`,
        `"${s.email}"`,
        `"${s.department}"`,
        `"${s.year || ''}"`,
        `"${s.phone || ''}"`,
        `"${s.registeredAt}"`,
        `"${s.attended ? 'Present' : 'Absent'}"`
      ];
      csv += row.join(",") + "\n";
    });

    const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.setAttribute("href", url);
    link.setAttribute("download", `${this.activeRosterEvent.id}_Attendee_Roster.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);

    this.showToast("Attendee CSV roster downloaded!", "success");
  }

  // Modal Close Helper
  closeModal(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) modal.classList.add("hidden");
  }

  // Toast Notification System
  showToast(message, type = "info") {
    const container = document.getElementById("toastContainer");
    if (!container) return;

    const toast = document.createElement("div");
    toast.className = `toast toast-${type}`;

    let icon = "ℹ️";
    if (type === "success") icon = "✅";
    if (type === "error") icon = "⚠️";

    toast.innerHTML = `<span>${icon}</span> <span>${message}</span>`;
    container.appendChild(toast);

    setTimeout(() => {
      toast.style.opacity = "0";
      toast.style.transform = "translateY(10px)";
      toast.style.transition = "all 0.3s ease";
      setTimeout(() => toast.remove(), 300);
    }, 3500);
  }
}

