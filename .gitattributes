    const uniqueTicketId = "TKT-" + Math.floor(100000 + Math.random() * 900000);
    const now = new Date();
    const formattedRegTime = now.toISOString().replace("T", " ").substring(0, 16);

    const attendeeRecord = {
      ticketId: uniqueTicketId,
      name: studentName,
      studentId: studentId,
      email: studentEmail,
      department: studentDept,
      year: studentYear,
      phone: studentPhone || "N/A",
      registeredAt: formattedRegTime,
      attended: false
    };

    // Save to event roster
    event.registeredStudents.push(attendeeRecord);

    // Save to user's registered tickets
    const ticketRecord = {
      ...attendeeRecord,
      eventId: event.id,
      eventTitle: event.title,
      category: event.category,
      date: event.date,
      time: event.time,
      venue: event.venue,
      organizer: event.organizer
    };
    this.myRegistrations.unshift(ticketRecord);

    this.saveState();
    this.closeModal("registrationModal");
    e.target.reset();

    this.renderEvents();
    this.updateMyTicketsBadge();
    this.updateAdminDashboard();

    this.showToast("Registration Successful! Your ticket has been generated.", "success");
    this.showTicketModal(ticketRecord);
