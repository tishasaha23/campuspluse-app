  // Open Event Registration Modal
  openRegistrationModal(eventId) {
    const event = this.events.find(e => e.id === eventId);
    if (!event) return;

    const regCount = (event.registeredStudents || []).length;
    const seatsLeft = event.capacity - regCount;

    if (seatsLeft <= 0) {
      this.showToast("Sorry, this event has reached maximum capacity!", "error");
      return;
    }

    document.getElementById("regEventId").value = event.id;
    document.getElementById("regEventCategory").textContent = event.category;
    document.getElementById("regEventTitle").textContent = event.title;
    document.getElementById("regEventDateTime").textContent = `${this.formatDate(event.date)} @ ${this.formatTime(event.time)}`;
    document.getElementById("regEventVenue").textContent = event.venue;
    document.getElementById("regEventSeatsLeft").textContent = `${seatsLeft} of ${event.capacity} seats remaining`;

    document.getElementById("registrationModal").classList.remove("hidden");
  }

  // Handle Student Registration Submit
  handleRegistrationSubmit(e) {
    e.preventDefault();

    const eventId = document.getElementById("regEventId").value;
    const studentName = document.getElementById("studentName").value.trim();
    const studentId = document.getElementById("studentId").value.trim().toUpperCase();
    const studentEmail = document.getElementById("studentEmail").value.trim().toLowerCase();
    const studentDept = document.getElementById("studentDept").value;
    const studentYear = document.getElementById("studentYear").value;
    const studentPhone = document.getElementById("studentPhone").value.trim();

    const event = this.events.find(ev => ev.id === eventId);
    if (!event) {
      this.showToast("Event not found!", "error");
      return;
    }

    if (!event.registeredStudents) {
      event.registeredStudents = [];
    }

    // Check duplicate student registration
    const existing = event.registeredStudents.find(s => s.studentId === studentId);
    if (existing) {
      this.showToast(`Student ID ${studentId} is already registered for this event!`, "error");
      return;
    }

    // Check capacity
    if (event.registeredStudents.length >= event.capacity) {
      this.showToast("Sorry, this event is already full!", "error");
      return;
    }

    const uniqueTicketId = "TKT-" + Math.floor(100000 + Math.random() * 900000);
    const now = new Date();
    const formattedRegTime = now.toISOString().replace("T", " ").substring(0, 16);

    const attendeeRecord = {
      ticketId: uniqueTicketId,
      name: studentName,
      studentId: studentId,
      email: studentEmail,
      department: studentDept,
      year: studentYear,
      phone: studentPhone || "N/A",
      registeredAt: formattedRegTime,
      attended: false
    };

    // Save to event roster
    event.registeredStudents.push(attendeeRecord);

    // Save to user's registered tickets
    const ticketRecord = {
      ...attendeeRecord,
      eventId: event.id,
      eventTitle: event.title,
      category: event.category,
      date: event.date,
      time: event.time,
      venue: event.venue,
      organizer: event.organizer
    };
    this.myRegistrations.unshift(ticketRecord);

    this.saveState();
    this.closeModal("registrationModal");
    e.target.reset();

    this.renderEvents();
    this.updateMyTicketsBadge();
    this.updateAdminDashboard();

    this.showToast("Registration Successful! Your ticket has been generated.", "success");
    this.showTicketModal(ticketRecord);
  }

  // View Ticket by Event ID
  viewMyTicketByEvent(eventId) {
    const ticket = this.myRegistrations.find(t => t.eventId === eventId);
    if (ticket) {
      this.showTicketModal(ticket);
    } else {
      this.showToast("No ticket found for this event.", "error");
    }
  }

