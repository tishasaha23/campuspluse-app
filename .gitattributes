    document.getElementById("tktCategory").textContent = ticket.category || "CAMPUS EVENT";
    document.getElementById("tktRegId").textContent = ticket.ticketId;
    document.getElementById("tktEventTitle").textContent = ticket.eventTitle;
    document.getElementById("tktDate").textContent = `${this.formatDate(ticket.date)} • ${this.formatTime(ticket.time)}`;
    document.getElementById("tktVenue").textContent = ticket.venue;
    document.getElementById("tktOrganizer").textContent = ticket.organizer;

    document.getElementById("tktAttendeeName").textContent = ticket.name;
    document.getElementById("tktAttendeeId").textContent = ticket.studentId;
    document.getElementById("tktDept").textContent = `${ticket.department} (${ticket.year || "Student"})`;
