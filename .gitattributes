class CampusEventManager {
  constructor() {
    this.events = [];
    this.myRegistrations = [];
    this.currentFilterCategory = "All";
    this.currentSearchQuery = "";
    this.currentStatusFilter = "All";
    this.activeRosterEvent = null;

    this.init();
  }

  init() {
    this.loadState();
    this.renderEvents();
    this.updateMyTicketsBadge();
    this.updateAdminDashboard();
  }

  // LocalStorage state management
  loadState() {
    const storedEvents = localStorage.getItem("campuspulse_events");
    const storedRegistrations = localStorage.getItem("campuspulse_my_tickets");

    if (storedEvents) {
      try {
        this.events = JSON.parse(storedEvents);
      } catch (e) {
        this.events = [...DEFAULT_EVENTS];
      }
    } else {
      this.events = [...DEFAULT_EVENTS];
      this.saveState();
    }

    if (storedRegistrations) {
      try {
        this.myRegistrations = JSON.parse(storedRegistrations);
      } catch (e) {
        this.myRegistrations = [];
      }
    } else {
      // Seed initial student ticket for demo
      this.myRegistrations = [
        {
          ticketId: "TKT-829104",
          eventId: "EVT-101",
          eventTitle: "HackCampus 2026: 24h AI & Cloud Sprint",
          category: "Technical",
          date: "2026-11-05",
          time: "09:30",
          venue: "Innovation Hub, Tech Block 4",
          organizer: "Computer Science Society & ACM Club",
          name: "Aarav Sharma",
          studentId: "CS2024-019",
          department: "Computer Science",
          year: "3rd Year",
          registeredAt: "2026-10-20 14:32"
        }
      ];
      this.saveState();
    }
  }

  saveState() {
    localStorage.setItem("campuspulse_events", JSON.stringify(this.events));
    localStorage.setItem("campuspulse_my_tickets", JSON.stringify(this.myRegistrations));
  }

  resetData() {
    if (confirm("Reset all events and tickets to default demo state?")) {
      localStorage.removeItem("campuspulse_events");
      localStorage.removeItem("campuspulse_my_tickets");
      this.events = [...DEFAULT_EVENTS];
      this.myRegistrations = [
        {
          ticketId: "TKT-829104",
          eventId: "EVT-101",
          eventTitle: "HackCampus 2026: 24h AI & Cloud Sprint",
          category: "Technical",
          date: "2026-11-05",
          time: "09:30",
          venue: "Innovation Hub, Tech Block 4",
          organizer: "Computer Science Society & ACM Club",
          name: "Aarav Sharma",
          studentId: "CS2024-019",
          department: "Computer Science",
          year: "3rd Year",
          registeredAt: "2026-10-20 14:32"
        }
      ];
      this.saveState();
      this.renderEvents();
      this.renderMyTickets();
      this.updateMyTicketsBadge();
      this.updateAdminDashboard();
      this.showToast("Demo data successfully restored!", "success");
    }
  }

  // Navigation tab switcher
  switchTab(tabId) {
    document.querySelectorAll(".tab-pane").forEach(pane => pane.classList.remove("active"));
    document.querySelectorAll(".nav-tab").forEach(tab => tab.classList.remove("active"));

    const targetPane = document.getElementById(`tab-${tabId}`);
    const targetTab = document.querySelector(`[data-tab="${tabId}"]`);

    if (targetPane) targetPane.classList.add("active");
    if (targetTab) targetTab.classList.add("active");

    if (tabId === "my-tickets") {
      this.renderMyTickets();
    } else if (tabId === "admin") {
      this.updateAdminDashboard();
    } else if (tabId === "explore") {
      this.renderEvents();
    }
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  // Search & Filtering
  filterEvents() {
    this.currentSearchQuery = document.getElementById("searchInput").value.trim().toLowerCase();
    this.currentFilterCategory = document.getElementById("categoryFilter").value;
    this.currentStatusFilter = document.getElementById("statusFilter").value;
    this.renderEvents();
  }

  setQuickFilter(category, buttonEl) {
    document.querySelectorAll(".category-chips .chip").forEach(btn => btn.classList.remove("active"));
    buttonEl.classList.add("active");

    const categorySelect = document.getElementById("categoryFilter");
    if (categorySelect) categorySelect.value = category;

    this.currentFilterCategory = category;
    this.renderEvents();
  }

  clearFilters() {
    document.getElementById("searchInput").value = "";
    document.getElementById("categoryFilter").value = "All";
    document.getElementById("statusFilter").value = "All";
    document.querySelectorAll(".category-chips .chip").forEach(btn => {
      btn.classList.toggle("active", btn.textContent.trim() === "All Events");
    });
    this.currentSearchQuery = "";
    this.currentFilterCategory = "All";
    this.currentStatusFilter = "All";
    this.renderEvents();
  }

  getFilteredEvents() {
    return this.events.filter(event => {
      // Category match
      const matchCategory = this.currentFilterCategory === "All" || event.category === this.currentFilterCategory;

      // Search query match (title, description, organizer, venue, tags)
      const q = this.currentSearchQuery;
      const matchSearch = !q || (
        event.title.toLowerCase().includes(q) ||
        event.organizer.toLowerCase().includes(q) ||
        event.venue.toLowerCase().includes(q) ||
        event.description.toLowerCase().includes(q) ||
        (event.tags && event.tags.some(tag => tag.toLowerCase().includes(q)))
      );

      // Status filter match
      const booked = (event.registeredStudents || []).length;
      const seatsLeft = event.capacity - booked;
      let matchStatus = true;
      if (this.currentStatusFilter === "Available") {
        matchStatus = seatsLeft > 0;
      } else if (this.currentStatusFilter === "FastFilling") {
        matchStatus = seatsLeft > 0 && (booked / event.capacity >= 0.7);
      }

      return matchCategory && matchSearch && matchStatus;
    });
  }

  // Format Helpers
  formatDate(dateStr) {
    try {
      const options = { weekday: "short", month: "short", day: "numeric", year: "numeric" };
      return new Date(dateStr).toLocaleDateString("en-US", options);
    } catch (e) {
      return dateStr;
    }
  }

  formatTime(timeStr) {
    if (!timeStr) return "";
    const [h, m] = timeStr.split(":");
    const hour = parseInt(h, 10);
    const ampm = hour >= 12 ? "PM" : "AM";
    const formattedHour = hour % 12 || 12;
    return `${formattedHour}:${m} ${ampm}`;
  }

  getCategoryClass(category) {
    switch (category.toLowerCase()) {
      case "technical": return "tech";
      case "cultural": return "cultural";
      case "sports": return "sports";
      case "academic": return "academic";
      case "workshop": return "workshop";
      default: return "";
    }
  }

  // Render Event Discovery Grid
  renderEvents() {
    const grid = document.getElementById("eventsGrid");
    const emptyState = document.getElementById("noEventsState");
    const countLabel = document.getElementById("eventsCountLabel");

    const filtered = this.getFilteredEvents();

    if (countLabel) {
      countLabel.textContent = `Showing ${filtered.length} of ${this.events.length} campus events`;
    }

    if (filtered.length === 0) {
      grid.innerHTML = "";
      emptyState.classList.remove("hidden");
      return;
    }

    emptyState.classList.add("hidden");

    grid.innerHTML = filtered.map(event => {
